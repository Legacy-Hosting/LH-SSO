NODE_ENV=development
HOST=127.0.0.1
PORT=8080
OIDC_PORT=8081
TRUST_PROXY=false
DATABASE_URL=mysql://legacyhosting_sso:password@host:25060/legacyhosting_sso?ssl-mode=REQUIRED
DATABASE_SSL_CA=/path/to/digitalocean-mysql-ca.pem
DATABASE_CONNECT_TIMEOUT_MS=5000
LH_DISCORD_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
LH_IDENTITY_BRIDGE_TOKEN=replace-with-a-different-32-character-secret
OIDC_ISSUER=https://auth.legacyhosting.xyz
OIDC_COOKIE_KEYS_JSON=["replace-with-current-32-character-cookie-key","replace-with-previous-32-character-cookie-key"]
OIDC_JWKS_FILE=/etc/legacy-hosting/sso-oidc-jwks.json
OIDC_CLIENTS_JSON=[{"client_id":"lh-panel","client_secret":"replace-with-random-client-secret","redirect_uris":["https://api.legacyhosting.xyz/api/v1/auth/oidc/callback"],"post_logout_redirect_uris":["https://panel.legacyhosting.xyz/"],"grant_types":["authorization_code","refresh_token"],"response_types":["code"],"token_endpoint_auth_method":"client_secret_basic","lh_resource":"https://api.legacyhosting.xyz"},{"client_id":"lh-hub","client_secret":"replace-with-another-random-client-secret","redirect_uris":["https://hub.legacyhosting.xyz/auth/callback"],"post_logout_redirect_uris":["https://hub.legacyhosting.xyz/"],"grant_types":["authorization_code","refresh_token"],"response_types":["code"],"token_endpoint_auth_method":"client_secret_basic","lh_resource":"https://hub.legacyhosting.xyz"}]
OIDC_RESOURCES_JSON=[{"identifier":"https://api.legacyhosting.xyz","audience":"lh-api","scopes":["openid","profile","email","roles"]},{"identifier":"https://hub.legacyhosting.xyz","audience":"lh-hub","scopes":["openid","profile","email","roles"]}]
OIDC_LEGACY_LOGIN_URL=https://panel.legacyhosting.xyz/login
