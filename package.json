{
  "name": "@legacyhosting/sso",
  "version": "1.3.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.4.1"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:oidc": "tsx watch src/oidc-server.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "passkeys:migrate-legacy": "node dist/src/migrate-legacy-passkeys.js",
    "oidc:generate-keys": "node ops/scripts/generate-oidc-keys.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/formbody": "9.0.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@simplewebauthn/server": "14.0.2",
    "dotenv": "18.0.4",
    "fastify": "5.12.5",
    "mysql2": "3.24.4",
    "oidc-provider": "9.12.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/oidc-provider": "^9.12.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
